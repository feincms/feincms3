#: admin.py:80
#, python-format
msgid "Move %s"
msgstr "Sposta %s"

#: admin.py:85
#, python-format
msgid "Clone %s"
msgstr "Clona %s"

#: admin.py:167
msgid "New location"
msgstr "Nuova posizione"

#: admin.py:175
msgid ""
"Moving isn't possible because there are no valid targets. Maybe you selected "
"the only root node?"
msgstr ""
"Lo spostamento non è possibile perché non ci sono bersagli validi. Forse hai "
"selezionato l'unico nodo radice?"

#: admin.py:221 admin.py:232 admin.py:242
msgid "move here"
msgstr "sposta qui"

#: admin.py:304
#, python-format
msgid "The node %(node)s has been moved to the new position."
msgstr "Il nodo %(node)s è stato spostato nella nuova posizione."

#: admin.py:322 redirects/admin.py:82
msgid "target"
msgstr "destinazione"

#: admin.py:332
msgid "Replace target's content"
msgstr "Sostituisci il contenuto della destinazione"

#: admin.py:334
#, python-format
msgid "Affects the following models: %s."
msgstr "Riguarda i seguenti modelli: %s."

#: admin.py:356
#, python-format
msgid "Current: \"%s\""
msgstr "Attuale: «%s»"

#: admin.py:373
msgid "Cannot clone node to itself."
msgstr "Impossibile clonare un nodo su se stesso."

#: admin.py:400
#, python-format
msgid "Updated fields of %(node)s: %(fields)s"
msgstr "Campi aggiornati di %(node)s: %(fields)s"

#: admin.py:422
#, python-format
msgid "Replaced the content of %(target)s with the contents of %(source)s."
msgstr ""
"Il contenuto di %(target)s è stato sostituito con il contenuto di %(source)s."

#: applications.py:528
msgid "page type"
msgstr "tipo di pagina"

#: applications.py:530
msgid "app instance namespace"
msgstr "spazio dei nomi istanza dell’app"

#: applications.py:572
#, python-format
msgid "This field is required for the page type \"%s\"."
msgstr "Questo campo è obbligatorio per il tipo di pagina “%s”."

#: applications.py:600
#, python-brace-format
msgid ""
"The page type \"{page_type}\" with the specified configuration exists "
"already."
msgstr ""
"Il tipo di pagina “{page_type}” con la configurazione specificata esiste già."

#: mixins.py:31
#, python-brace-format
msgid "Its language ({language}) differs from its parent's ({parent})."
msgstr ""
"La sua lingua ({language}) è diversa da quella del genitore ({parent})."

#: mixins.py:43
msgid "menu"
msgstr "menù"

#: mixins.py:95 plugins/snippet.py:33
msgid "template"
msgstr "modello"

#: mixins.py:138
msgid "language"
msgstr "lingua"

#: mixins.py:171
msgid "translation of"
msgstr "traduzione di"

#: mixins.py:232
msgid ""
"Objects in the primary language cannot be the translation of another object."
msgstr ""
"Gli oggetti nella lingua principale non possono essere la traduzione di un "
"altro oggetto."

#: mixins.py:246
msgid "Redirect to URL"
msgstr "Reindirizza all’URL"

#: mixins.py:254
msgid "Redirect to page"
msgstr "Reindirizza alla pagina"

#: mixins.py:277
msgid "Only set one redirect value."
msgstr "Imposta un solo valore di reindirizzamento."

#: mixins.py:285
msgid "Cannot redirect to self."
msgstr "Impossibile reindirizzare a se stesso."

#: mixins.py:296
#, python-format
msgid ""
"Do not chain redirects. The selected page \"%(title)s\" redirects to "
"\"%(path)s\"."
msgstr ""
"Non concatenare i reindirizzamenti. La pagina selezionata “%(title)s” "
"reindirizza a “%(path)s”."

#: mixins.py:313
#, python-format
msgid ""
"Do not chain redirects. The following pages already redirect to this page: "
"%(pages)s"
msgstr ""
"Non concatenare i reindirizzamenti. Le seguenti pagine reindirizzano già a "
"questa pagina: %(pages)s"

#: mixins.py:334
msgid "Redirects"
msgstr "Reindirizzamenti"

#: pages.py:83
msgid "is active"
msgstr "è attivo"

#: pages.py:84
msgid "title"
msgstr "titolo"

#: pages.py:85
msgid "slug"
msgstr "slug"

#: pages.py:89 redirects/models.py:117
msgid "path"
msgstr "percorso"

#: pages.py:94
msgid ""
"Automatically generated by concatenating the parent's path and the slug "
"unless the path is defined manually."
msgstr ""
"Generato automaticamente concatenando il percorso del genitore e lo slug, a "
"meno che il percorso non sia definito manualmente."

#: pages.py:100
msgid "Path must start and end with a slash (/)."
msgstr "Il percorso deve iniziare e terminare con una barra (/)."

#: pages.py:104
msgid "manually define the path"
msgstr "definisci il percorso manualmente"

#: pages.py:110
msgid "page"
msgstr "pagina"

#: pages.py:111
msgid "pages"
msgstr "pagine"

#: pages.py:160
msgid "Static paths cannot be empty. Did you mean '/'?"
msgstr "I percorsi statici non possono essere vuoti. Intendevi '/'?"

#: pages.py:178 pages.py:192
#, python-format
msgid "The page %(page)s's new path %(path)s would not be unique."
msgstr "Il nuovo percorso %(path)s della pagina %(page)s non sarebbe univoco."

#: plugins/external.py:117
msgid "URL"
msgstr "URL"

#: plugins/external.py:119 plugins/image.py:42
msgid "alternative text"
msgstr "testo alternativo"

#: plugins/external.py:120 plugins/image.py:43
msgid "Describe the contents, e.g. for screenreaders."
msgstr "Descrivi il contenuto, ad es. per i lettori di schermo."

#: plugins/external.py:124 plugins/image.py:47
msgid "caption"
msgstr "didascalia"

#: plugins/external.py:128
msgid "external content"
msgstr "contenuto esterno"

#: plugins/external.py:162
msgid "Unable to fetch HTML for this URL, sorry!"
msgstr "Impossibile recuperare l’HTML per questo URL, spiacenti!"

#: plugins/html.py:26
msgid ""
"The content will be inserted directly into the page. It is VERY important "
"that the HTML snippet is well-formed!"
msgstr ""
"Il contenuto verrà inserito direttamente nella pagina. È MOLTO importante "
"che il frammento HTML sia ben formato!"

#: plugins/html.py:60
msgid ""
"Please note that the HTML must be well formed. It's your responsibility to "
"ensure that nothing breaks now or in the future when using this plugin."
msgstr ""
"Nota che l’HTML deve essere ben formato. È tua responsabilità assicurarti "
"che nulla si rompa, ora o in futuro, usando questo plugin."

#: plugins/image.py:26 plugins/image.py:51
msgid "image"
msgstr "imagine"

#: plugins/image.py:35
msgid "image width"
msgstr "larghezza immagine"

#: plugins/image.py:38
msgid "image height"
msgstr "altezza immagine"

#: plugins/image.py:40
msgid "primary point of interest"
msgstr "punto di interesse principale"

#: plugins/image.py:52
msgid "images"
msgstr "imagini"

#: plugins/old_richtext.py:41 plugins/richtext.py:36
msgid "text"
msgstr "testo"

#: plugins/old_richtext.py:45 plugins/richtext.py:40
msgid "rich text"
msgstr "testo formattato"

#: plugins/old_richtext.py:46 plugins/richtext.py:41
msgid "rich texts"
msgstr "testi formattati"

#: plugins/snippet.py:37
msgid "predefined snippet"
msgstr "frammento predefinito"

#: plugins/snippet.py:38
msgid "predefined snippets"
msgstr "frammenti predefiniti"

#: redirects/admin.py:58
msgid "Target"
msgstr "Destinazione"

#: redirects/admin.py:62
msgid ""
"Either enter an URL or select an object. Redirects to objects follow them "
"when their URL changes."
msgstr ""
"Inserisci un URL o seleziona un oggetto. I reindirizzamenti verso oggetti li "
"seguono quando il loro URL cambia."

#: redirects/admin.py:87
msgid "(does not exist)"
msgstr "(non esiste)"

#: redirects/apps.py:14 redirects/models.py:157
msgid "redirects"
msgstr "reindirizzamenti"

#: redirects/models.py:109
msgid "created at"
msgstr "creato il"

#: redirects/models.py:111
msgid "host"
msgstr "host"

#: redirects/models.py:114
msgid "Leave empty to redirect requests to all hosts."
msgstr "Lascia vuoto per reindirizzare le richieste di tutti gli host."

#: redirects/models.py:120
msgid ""
"The path, starting with a slash and excluding the host. May contain a query "
"string, e.g. '/index.php?id=12'."
msgstr ""
"Il percorso, che inizia con una barra ed escluso l’host. Può contenere una "
"query string, ad es. '/index.php?id=12'."

#: redirects/models.py:129
msgid "content type"
msgstr "tipo di contenuto"

#: redirects/models.py:131
msgid "object ID"
msgstr "ID dell’oggetto"

#: redirects/models.py:134
msgid "target URL"
msgstr "URL di destinazione"

#: redirects/models.py:137
msgid "An absolute path or a full URL."
msgstr "Un percorso assoluto o un URL completo."

#: redirects/models.py:140
msgid "is automatic"
msgstr "è automatico"

#: redirects/models.py:142
msgid "Recorded automatically when saving the target object."
msgstr ""
"Registrato automaticamente al salvataggio dell’oggetto di destinazione."

#: redirects/models.py:144
msgid "permanent"
msgstr "permanente"

#: redirects/models.py:156
msgid "redirect"
msgstr "reindirizzamento"

#: redirects/models.py:167
msgid "The path must start with a slash."
msgstr "Il percorso deve iniziare con una barra."

#: redirects/models.py:177
msgid "Set either a target URL or a target object."
msgstr "Imposta un URL di destinazione oppure un oggetto di destinazione."

#: redirects/models.py:185
msgid "Objects of this type cannot be redirected to."
msgstr "Non è possibile reindirizzare verso oggetti di questo tipo."

#: redirects/models.py:191
msgid "The target object does not exist."
msgstr "L’oggetto di destinazione non esiste."

