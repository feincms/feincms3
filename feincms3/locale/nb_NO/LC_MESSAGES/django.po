#: admin.py:80
#, python-format
msgid "Move %s"
msgstr "Flytt %s"

#: admin.py:85
#, python-format
msgid "Clone %s"
msgstr "Klon %s"

#: admin.py:167
msgid "New location"
msgstr "Ny plassering"

#: admin.py:175
msgid ""
"Moving isn't possible because there are no valid targets. Maybe you selected "
"the only root node?"
msgstr ""
"Flytting er ikke mulig fordi det ikke er noen gyldige mål. Kanskje du valgte "
"den eneste rotnoden?"

#: admin.py:221 admin.py:232 admin.py:242
msgid "move here"
msgstr "flytt hit"

#: admin.py:304
#, python-format
msgid "The node %(node)s has been moved to the new position."
msgstr "Noden %(node)s har blitt flyttet til ny plassering"

#: admin.py:322 redirects/admin.py:82
msgid "target"
msgstr "mål"

#: admin.py:332
msgid "Replace target's content"
msgstr "Erstatt målets innhold"

#: admin.py:334
#, python-format
msgid "Affects the following models: %s."
msgstr "Har innvirkning på følgende moduler: %s."

#: admin.py:356
#, python-format
msgid "Current: \"%s\""
msgstr "Nåværende: «%s»"

#: admin.py:373
msgid "Cannot clone node to itself."
msgstr "Kan ikke klone node til seg selv."

#: admin.py:400
#, python-format
msgid "Updated fields of %(node)s: %(fields)s"
msgstr "Oppdaterte felter tilhørende %(node)s: %(fields)s"

#: admin.py:422
#, python-format
msgid "Replaced the content of %(target)s with the contents of %(source)s."
msgstr "Erstattet innholdet i %(target)s med innholdet i %(source)s."

#: applications.py:528
msgid "page type"
msgstr "sidetype"

#: applications.py:530
msgid "app instance namespace"
msgstr "programinstans-navnerom"

#: applications.py:572
#, python-format
msgid "This field is required for the page type \"%s\"."
msgstr "Dette feltet kreves for sidetypen «%s»."

#: applications.py:600
#, python-brace-format
msgid ""
"The page type \"{page_type}\" with the specified configuration exists "
"already."
msgstr ""
"Sidetypen «{page_type}» med den angitte konfigurasjonen finnes allerede."

#: mixins.py:31
#, python-brace-format
msgid "Its language ({language}) differs from its parent's ({parent})."
msgstr "Språket ({language}) avviker fra språket til forelderen ({parent})."

#: mixins.py:43
msgid "menu"
msgstr "meny"

#: mixins.py:95 plugins/snippet.py:33
msgid "template"
msgstr "mal"

#: mixins.py:138
msgid "language"
msgstr "språk"

#: mixins.py:171
msgid "translation of"
msgstr "oversettelse av"

#: mixins.py:232
msgid ""
"Objects in the primary language cannot be the translation of another object."
msgstr ""
"Objekter i primærspråket kan ikke være oversettelsen av et annet objekt."

#: mixins.py:246
msgid "Redirect to URL"
msgstr "Videresendt til nettadresse"

#: mixins.py:254
msgid "Redirect to page"
msgstr "Videresendt til side"

#: mixins.py:277
msgid "Only set one redirect value."
msgstr "Kun sett én videresendingsverdi."

#: mixins.py:285
msgid "Cannot redirect to self."
msgstr "Kan ikke videresende til seg selv."

#: mixins.py:296
#, python-format
msgid ""
"Do not chain redirects. The selected page \"%(title)s\" redirects to "
"\"%(path)s\"."
msgstr ""
"Kan ikke opprette videresendelser i stafett. Valgt side «%(title)s» "
"videresender til «%(path)s»."

#: mixins.py:313
#, python-format
msgid ""
"Do not chain redirects. The following pages already redirect to this page: "
"%(pages)s"
msgstr ""
"Ikke opprett videresendelser i stafett. Følgende sider videresender til "
"denne siden: %(pages)s"

#: mixins.py:334
msgid "Redirects"
msgstr "Videresendinger"

#: pages.py:83
msgid "is active"
msgstr "er aktiv"

#: pages.py:84
msgid "title"
msgstr "tittel"

#: pages.py:85
msgid "slug"
msgstr "slug"

#: pages.py:89 redirects/models.py:117
msgid "path"
msgstr "sti"

#: pages.py:94
msgid ""
"Automatically generated by concatenating the parent's path and the slug "
"unless the path is defined manually."
msgstr ""
"Genereres automatisk ved å slå sammen forelderens sti og slug, med mindre "
"stien defineres manuelt."

#: pages.py:100
msgid "Path must start and end with a slash (/)."
msgstr "Sti må starte og slutt med skråstrek (/)."

#: pages.py:104
msgid "manually define the path"
msgstr "definer stien manuelt"

#: pages.py:110
msgid "page"
msgstr "side"

#: pages.py:111
msgid "pages"
msgstr "sider"

#: pages.py:160
msgid "Static paths cannot be empty. Did you mean '/'?"
msgstr "Statiske stier må fylles ut. Mente du «/»?"

#: pages.py:178 pages.py:192
#, python-format
msgid "The page %(page)s's new path %(path)s would not be unique."
msgstr "Siden «%(page)s» sin nye sti %(path)s finnes allerede."

#: plugins/external.py:117
msgid "URL"
msgstr "Nettadresse"

#: plugins/external.py:119 plugins/image.py:42
msgid "alternative text"
msgstr "alternativ tekst"

#: plugins/external.py:120 plugins/image.py:43
msgid "Describe the contents, e.g. for screenreaders."
msgstr "Beskriv innholdet, f.eks. for skjermlesere."

#: plugins/external.py:124 plugins/image.py:47
msgid "caption"
msgstr "bildetekst"

#: plugins/external.py:128
msgid "external content"
msgstr "eksternt innhold"

#: plugins/external.py:162
msgid "Unable to fetch HTML for this URL, sorry!"
msgstr "Klarte ikke å hente HTML for denne nettadressen."

#: plugins/html.py:26
msgid ""
"The content will be inserted directly into the page. It is VERY important "
"that the HTML snippet is well-formed!"
msgstr ""
"Innholdet settes inn direkte på siden. Det er SVÆRT viktig at HTML-utdraget "
"er velformet!"

#: plugins/html.py:60
msgid ""
"Please note that the HTML must be well formed. It's your responsibility to "
"ensure that nothing breaks now or in the future when using this plugin."
msgstr ""
"Merk at HTML-en må være velformet. Det er ditt ansvar å sørge for at "
"ingenting går i stykker, nå eller i fremtiden, når du bruker dette tillegget."

#: plugins/image.py:26 plugins/image.py:51
msgid "image"
msgstr "bilde"

#: plugins/image.py:35
msgid "image width"
msgstr "bildebredde"

#: plugins/image.py:38
msgid "image height"
msgstr "bildehøyde"

#: plugins/image.py:40
msgid "primary point of interest"
msgstr "hoved-interessepunkt"

#: plugins/image.py:52
msgid "images"
msgstr "bilder"

#: plugins/old_richtext.py:41 plugins/richtext.py:36
msgid "text"
msgstr "tekst"

#: plugins/old_richtext.py:45 plugins/richtext.py:40
msgid "rich text"
msgstr "rik tekst"

#: plugins/old_richtext.py:46 plugins/richtext.py:41
msgid "rich texts"
msgstr "rike tekster"

#: plugins/snippet.py:37
msgid "predefined snippet"
msgstr "forhåndsdefinert utdrag"

#: plugins/snippet.py:38
msgid "predefined snippets"
msgstr "forhåndsdefinerte utdrag"

#: redirects/admin.py:58
msgid "Target"
msgstr "Mål"

#: redirects/admin.py:62
msgid ""
"Either enter an URL or select an object. Redirects to objects follow them "
"when their URL changes."
msgstr ""
"Skriv inn en nettadresse eller velg et objekt. Videresendinger til objekter "
"følger dem når nettadressen deres endres."

#: redirects/admin.py:87
msgid "(does not exist)"
msgstr "(finnes ikke)"

#: redirects/apps.py:14 redirects/models.py:157
msgid "redirects"
msgstr "videresendinger"

#: redirects/models.py:109
msgid "created at"
msgstr "opprettet"

#: redirects/models.py:111
msgid "host"
msgstr "vert"

#: redirects/models.py:114
msgid "Leave empty to redirect requests to all hosts."
msgstr "La stå tomt for å videresende forespørsler til alle verter."

#: redirects/models.py:120
msgid ""
"The path, starting with a slash and excluding the host. May contain a query "
"string, e.g. '/index.php?id=12'."
msgstr ""
"Stien, som starter med skråstrek og uten vert. Kan inneholde en "
"spørrestreng, f.eks. '/index.php?id=12'."

#: redirects/models.py:129
msgid "content type"
msgstr "innholdstype"

#: redirects/models.py:131
msgid "object ID"
msgstr "objekt-ID"

#: redirects/models.py:134
msgid "target URL"
msgstr "mål-nettadresse"

#: redirects/models.py:137
msgid "An absolute path or a full URL."
msgstr "En absolutt sti eller en fullstendig nettadresse."

#: redirects/models.py:140
msgid "is automatic"
msgstr "er automatisk"

#: redirects/models.py:142
msgid "Recorded automatically when saving the target object."
msgstr "Registreres automatisk når målobjektet lagres."

#: redirects/models.py:144
msgid "permanent"
msgstr "permanent"

#: redirects/models.py:156
msgid "redirect"
msgstr "videresending"

#: redirects/models.py:167
msgid "The path must start with a slash."
msgstr "Stien må starte med skråstrek."

#: redirects/models.py:177
msgid "Set either a target URL or a target object."
msgstr "Angi enten en mål-nettadresse eller et målobjekt."

#: redirects/models.py:185
msgid "Objects of this type cannot be redirected to."
msgstr "Objekter av denne typen kan ikke videresendes til."

#: redirects/models.py:191
msgid "The target object does not exist."
msgstr "Målobjektet finnes ikke."

