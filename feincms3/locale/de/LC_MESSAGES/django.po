#: admin.py:80
#, python-format
msgid "Move %s"
msgstr "%s verschieben"

#: admin.py:85
#, python-format
msgid "Clone %s"
msgstr "%s klonen"

#: admin.py:167
msgid "New location"
msgstr "Neuer Ort"

#: admin.py:175
msgid ""
"Moving isn't possible because there are no valid targets. Maybe you selected "
"the only root node?"
msgstr ""
"Verschieben ist nicht möglich weil es keine gültigen Zielorte gibt. "
"Vielleicht den einzigen Wurzelknoten gewählt?"

#: admin.py:221 admin.py:232 admin.py:242
msgid "move here"
msgstr "hierhin verschieben"

#: admin.py:304
#, python-format
msgid "The node %(node)s has been moved to the new position."
msgstr "%(node)s wurde zur neuen Position verschoben."

#: admin.py:322 redirects/admin.py:82
msgid "target"
msgstr "Ziel"

#: admin.py:332
msgid "Replace target's content"
msgstr "Inhalt des Ziels ersetzen"

#: admin.py:334
#, python-format
msgid "Affects the following models: %s."
msgstr "Betrifft die folgenden Inhalte: %s."

#: admin.py:356
#, python-format
msgid "Current: \"%s\""
msgstr "Aktuell: „%s“"

#: admin.py:373
msgid "Cannot clone node to itself."
msgstr "Kann Knoten nicht zu sich selbst klonen."

#: admin.py:400
#, python-format
msgid "Updated fields of %(node)s: %(fields)s"
msgstr "Aktualisierte Felder von %(node)s: %(fields)s"

#: admin.py:422
#, python-format
msgid "Replaced the content of %(target)s with the contents of %(source)s."
msgstr "Ersetzte den Inhalt von %(target)s mit dem Inhalt von %(source)s."

#: applications.py:528
msgid "page type"
msgstr "Seitentyp"

#: applications.py:530
msgid "app instance namespace"
msgstr "Namespace der App-Instanz"

#: applications.py:572
#, python-format
msgid "This field is required for the page type \"%s\"."
msgstr "Dieses Feld wird für den Seitentyp \"%s\" benötigt."

#: applications.py:600
#, python-brace-format
msgid ""
"The page type \"{page_type}\" with the specified configuration exists "
"already."
msgstr ""
"Der Seitentyp \"{page_type}\" mit der spezifizierten Konfiguration existiert "
"schon."

#: mixins.py:31
#, python-brace-format
msgid "Its language ({language}) differs from its parent's ({parent})."
msgstr ""
"Die Sprache ({language}) unterscheidet sich von der Sprache der "
"übergeordneten Seite ({parent})."

#: mixins.py:43
msgid "menu"
msgstr "Menü"

#: mixins.py:95 plugins/snippet.py:33
msgid "template"
msgstr "Vorlage"

#: mixins.py:138
msgid "language"
msgstr "Sprache"

#: mixins.py:171
msgid "translation of"
msgstr "Übersetzung von"

#: mixins.py:232
msgid ""
"Objects in the primary language cannot be the translation of another object."
msgstr ""
"Objekte in der primären Sprache können nicht eine Übersetzung eines anderen "
"Objektes sein."

#: mixins.py:246
msgid "Redirect to URL"
msgstr "Weiterleiten zu URL"

#: mixins.py:254
msgid "Redirect to page"
msgstr "Weiterleiten zu Seite"

#: mixins.py:277
msgid "Only set one redirect value."
msgstr "Bitte nur einen Weiterleitungs-Wert setzen."

#: mixins.py:285
msgid "Cannot redirect to self."
msgstr "Kann nicht zu sich selbst weiterleiten."

#: mixins.py:296
#, python-format
msgid ""
"Do not chain redirects. The selected page \"%(title)s\" redirects to "
"\"%(path)s\"."
msgstr ""
"Die gewählte Seite „%(title)s“ leitet schon weiter auf „%(path)s“ weiter, "
"bitte Verkettungen von Weiterleitungen vermeiden."

#: mixins.py:313
#, python-format
msgid ""
"Do not chain redirects. The following pages already redirect to this page: "
"%(pages)s"
msgstr ""
"Verkettung von Weiterleitungen nicht erlaubt. Die folgenden Seiten leiten "
"schon auf diese Seite weiter: %(pages)s"

#: mixins.py:334
msgid "Redirects"
msgstr "Weiterleitungen"

#: pages.py:83
msgid "is active"
msgstr "ist aktiv"

#: pages.py:84
msgid "title"
msgstr "Titel"

#: pages.py:85
msgid "slug"
msgstr "Slug"

#: pages.py:89 redirects/models.py:117
msgid "path"
msgstr "Pfad"

#: pages.py:94
msgid ""
"Automatically generated by concatenating the parent's path and the slug "
"unless the path is defined manually."
msgstr ""
"Wird automatisch generiert durch das Aneinananderhängen des Pfades der "
"übergeordneten Seite und des Slugs, ausser wenn der Pfad manuell definiert "
"wird."

#: pages.py:100
msgid "Path must start and end with a slash (/)."
msgstr "Pfad muss mit einem Slash (/) starten und enden."

#: pages.py:104
msgid "manually define the path"
msgstr "Pfad manuell definieren"

#: pages.py:110
msgid "page"
msgstr "Seite"

#: pages.py:111
msgid "pages"
msgstr "Seiten"

#: pages.py:160
msgid "Static paths cannot be empty. Did you mean '/'?"
msgstr "Statische Pfade können nicht leer sein. Meinten Sie „/“?"

#: pages.py:178 pages.py:192
#, python-format
msgid "The page %(page)s's new path %(path)s would not be unique."
msgstr "Der Pfad %(path)s der Seite %(page)s würde nicht eindeutig sein."

#: plugins/external.py:117
msgid "URL"
msgstr "URL"

#: plugins/external.py:119 plugins/image.py:42
msgid "alternative text"
msgstr "alternativer Text"

#: plugins/external.py:120 plugins/image.py:43
msgid "Describe the contents, e.g. for screenreaders."
msgstr "Beschreibung der Bildinhalte, zB für Screenreader."

#: plugins/external.py:124 plugins/image.py:47
msgid "caption"
msgstr "Legende"

#: plugins/external.py:128
msgid "external content"
msgstr "externer Inhalt"

#: plugins/external.py:162
msgid "Unable to fetch HTML for this URL, sorry!"
msgstr "Kann das HTML für diese URL nicht laden, tut mir leid!"

#: plugins/html.py:26
msgid ""
"The content will be inserted directly into the page. It is VERY important "
"that the HTML snippet is well-formed!"
msgstr ""
"Der Inhalt wird direkt in die Seite eingefügt. Es ist SEHR wichtig, dass das "
"HTML gültig ist!"

#: plugins/html.py:60
msgid ""
"Please note that the HTML must be well formed. It's your responsibility to "
"ensure that nothing breaks now or in the future when using this plugin."
msgstr ""
"Das HTML muss unbedingt wohlgeformt sein. Es liegt in Ihrer Verantwortung "
"sicherzustellen, dass jetzt und in Zukunft nichts schiefgeht, wenn Sie "
"dieses Plugin verwenden."

#: plugins/image.py:26 plugins/image.py:51
msgid "image"
msgstr "Bild"

#: plugins/image.py:35
msgid "image width"
msgstr "Bildbreite"

#: plugins/image.py:38
msgid "image height"
msgstr "Bildhöhe"

#: plugins/image.py:40
msgid "primary point of interest"
msgstr "Fokuspunkt"

#: plugins/image.py:52
msgid "images"
msgstr "Bilder"

#: plugins/old_richtext.py:41 plugins/richtext.py:36
msgid "text"
msgstr "Text"

#: plugins/old_richtext.py:45 plugins/richtext.py:40
msgid "rich text"
msgstr "Text"

#: plugins/old_richtext.py:46 plugins/richtext.py:41
msgid "rich texts"
msgstr "Texte"

#: plugins/snippet.py:37
msgid "predefined snippet"
msgstr "vordefinierter Baustein"

#: plugins/snippet.py:38
msgid "predefined snippets"
msgstr "vordefinierte Bausteine"

#: redirects/admin.py:58
msgid "Target"
msgstr "Ziel"

#: redirects/admin.py:62
msgid ""
"Either enter an URL or select an object. Redirects to objects follow them "
"when their URL changes."
msgstr ""
"Entweder eine URL eingeben oder ein Objekt auswählen. Weiterleitungen auf "
"Objekte folgen diesen, wenn sich ihre URL ändert."

#: redirects/admin.py:87
msgid "(does not exist)"
msgstr "(existiert nicht)"

#: redirects/apps.py:14 redirects/models.py:157
msgid "redirects"
msgstr "Weiterleitungen"

#: redirects/models.py:109
msgid "created at"
msgstr "erstellt am"

#: redirects/models.py:111
msgid "host"
msgstr "Host"

#: redirects/models.py:114
msgid "Leave empty to redirect requests to all hosts."
msgstr "Leer lassen, um Anfragen an alle Hosts weiterzuleiten."

#: redirects/models.py:120
msgid ""
"The path, starting with a slash and excluding the host. May contain a query "
"string, e.g. '/index.php?id=12'."
msgstr ""
"Der Pfad, beginnend mit einem Slash und ohne Host. Darf einen Query-String "
"enthalten, z.B. '/index.php?id=12'."

#: redirects/models.py:129
msgid "content type"
msgstr "Inhaltstyp"

#: redirects/models.py:131
msgid "object ID"
msgstr "Objekt-ID"

#: redirects/models.py:134
msgid "target URL"
msgstr "Ziel-URL"

#: redirects/models.py:137
msgid "An absolute path or a full URL."
msgstr "Ein absoluter Pfad oder eine vollständige URL."

#: redirects/models.py:140
msgid "is automatic"
msgstr "ist automatisch"

#: redirects/models.py:142
msgid "Recorded automatically when saving the target object."
msgstr "Wird beim Speichern des Zielobjekts automatisch erfasst."

#: redirects/models.py:144
msgid "permanent"
msgstr "permanent"

#: redirects/models.py:156
msgid "redirect"
msgstr "Weiterleitung"

#: redirects/models.py:167
msgid "The path must start with a slash."
msgstr "Der Pfad muss mit einem Slash beginnen."

#: redirects/models.py:177
msgid "Set either a target URL or a target object."
msgstr "Entweder eine Ziel-URL oder ein Zielobjekt setzen."

#: redirects/models.py:185
msgid "Objects of this type cannot be redirected to."
msgstr "Auf Objekte dieses Typs kann nicht weitergeleitet werden."

#: redirects/models.py:191
msgid "The target object does not exist."
msgstr "Das Zielobjekt existiert nicht."

