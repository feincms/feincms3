#: redirects/admin.py:58
msgid "Target"
msgstr "Cible"

#: redirects/admin.py:62
msgid ""
"Either enter an URL or select an object. Redirects to objects follow them "
"when their URL changes."
msgstr ""
"Saisissez une URL ou sélectionnez un objet. Les redirections vers des objets "
"les suivent lorsque leur URL change."

#: redirects/admin.py:87
msgid "(does not exist)"
msgstr "(n’existe pas)"

#: redirects/apps.py:14 redirects/models.py:157
msgid "redirects"
msgstr "redirections"

#: redirects/models.py:109
msgid "created at"
msgstr "créé le"

#: redirects/models.py:111
msgid "host"
msgstr "hôte"

#: redirects/models.py:114
msgid "Leave empty to redirect requests to all hosts."
msgstr "Laisser vide pour rediriger les requêtes de tous les hôtes."

#: redirects/models.py:120
msgid ""
"The path, starting with a slash and excluding the host. May contain a query "
"string, e.g. '/index.php?id=12'."
msgstr ""
"Le chemin, commençant par une barre oblique et sans l’hôte. Peut contenir "
"une chaîne de requête, p. ex. '/index.php?id=12'."

#: redirects/models.py:129
msgid "content type"
msgstr "type de contenu"

#: redirects/models.py:131
msgid "object ID"
msgstr "ID de l’objet"

#: redirects/models.py:134
msgid "target URL"
msgstr "URL cible"

#: redirects/models.py:137
msgid "An absolute path or a full URL."
msgstr "Un chemin absolu ou une URL complète."

#: redirects/models.py:140
msgid "is automatic"
msgstr "est automatique"

#: redirects/models.py:142
msgid "Recorded automatically when saving the target object."
msgstr "Enregistré automatiquement lors de l’enregistrement de l’objet cible."

#: redirects/models.py:144
msgid "permanent"
msgstr "permanente"

#: redirects/models.py:156
msgid "redirect"
msgstr "redirection"

#: redirects/models.py:167
msgid "The path must start with a slash."
msgstr "Le chemin doit commencer par une barre oblique."

#: redirects/models.py:177
msgid "Set either a target URL or a target object."
msgstr "Définissez soit une URL cible, soit un objet cible."

#: redirects/models.py:185
msgid "Objects of this type cannot be redirected to."
msgstr "Il n’est pas possible de rediriger vers des objets de ce type."

#: redirects/models.py:191
msgid "The target object does not exist."
msgstr "L’objet cible n’existe pas."

